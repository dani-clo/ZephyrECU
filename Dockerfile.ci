# Keep the base explicit; apt repositories can still change on a deliberate rebuild.
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac

ENV DEBIAN_FRONTEND=noninteractive \
    ZEPHYR_TOOLCHAIN_VARIANT=host \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    can-utils \
    cmake \
    device-tree-compiler \
    file \
    g++-multilib \
    gcc-multilib \
    git \
    gperf \
    iproute2 \
    libgl1 \
    libglib2.0-0t64 \
    libmagic1 \
    ninja-build \
    python3 \
    python3-dev \
    python3-venv \
    util-linux \
    && rm -rf /var/lib/apt/lists/*

COPY tools/requirements-ci.lock /opt/requirements-ci.lock
RUN python3 -m venv /opt/venv \
    && python -m pip install --no-cache-dir -r /opt/requirements-ci.lock \
    && python -m pip check

COPY tools/docker_entrypoint.sh /usr/local/bin/zephyrecu-entrypoint
RUN chmod 755 /usr/local/bin/zephyrecu-entrypoint

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/zephyrecu-entrypoint"]
CMD ["/workspace/ZephyrECU/tools/run_ci.sh"]
